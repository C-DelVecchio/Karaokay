{
  "openapi": "3.1.1",
  "info": {
    "title": "Karaokay.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/songs": {
      "get": {
        "tags": [
          "Karaokay.Api"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SongSummaryDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/songs/{songId}/instrumental": {
      "get": {
        "tags": [
          "Karaokay.Api"
        ],
        "parameters": [
          {
            "name": "songId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/songs/{songId}/vocals": {
      "get": {
        "tags": [
          "Karaokay.Api"
        ],
        "parameters": [
          {
            "name": "songId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/songs/{songId}/lyrics": {
      "get": {
        "tags": [
          "Karaokay.Api"
        ],
        "parameters": [
          {
            "name": "songId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/songs/{songId}/video": {
      "get": {
        "tags": [
          "Karaokay.Api"
        ],
        "parameters": [
          {
            "name": "songId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/rooms": {
      "post": {
        "tags": [
          "Karaokay.Api"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateRoomResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/rooms/{code}": {
      "get": {
        "tags": [
          "Karaokay.Api"
        ],
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomSnapshot"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/rooms/{code}/qr": {
      "get": {
        "tags": [
          "Karaokay.Api"
        ],
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/youtube/search": {
      "get": {
        "tags": [
          "Karaokay.Api"
        ],
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "maxResults",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/YouTubeSearchResultDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/youtube/enqueue": {
      "post": {
        "tags": [
          "Karaokay.Api"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/YouTubeEnqueueRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueAck"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateRoomResponse": {
        "required": [
          "code",
          "roomId"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "roomId": {
            "type": "string"
          }
        }
      },
      "MediaSource": {
        "type": "integer"
      },
      "PlaybackStateDto": {
        "required": [
          "status",
          "currentQueueItemId",
          "currentSong",
          "positionMs",
          "timeAnchorUtc",
          "guideVocalVolume",
          "countdownRemainingBeats"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/PlaybackStatus"
          },
          "currentQueueItemId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "currentSong": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SongDto"
              }
            ]
          },
          "positionMs": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "timeAnchorUtc": {
            "type": "string",
            "format": "date-time"
          },
          "guideVocalVolume": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "countdownRemainingBeats": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "PlaybackStatus": {
        "type": "integer"
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "QueueAck": {
        "required": [
          "success",
          "queueItemId",
          "reason"
        ],
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "queueItemId": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "QueueItemDto": {
        "required": [
          "id",
          "songId",
          "position",
          "requestedByName",
          "state"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "songId": {
            "type": "string",
            "format": "uuid"
          },
          "position": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "requestedByName": {
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/QueueItemState"
          }
        }
      },
      "QueueItemState": {
        "type": "integer"
      },
      "RoomSnapshot": {
        "required": [
          "roomCode",
          "status",
          "playback",
          "queue",
          "guestCount",
          "queueSequence"
        ],
        "type": "object",
        "properties": {
          "roomCode": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/PlaybackStatus"
          },
          "playback": {
            "$ref": "#/components/schemas/PlaybackStateDto"
          },
          "queue": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QueueItemDto"
            }
          },
          "guestCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "queueSequence": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "SongDto": {
        "required": [
          "id",
          "title",
          "artist",
          "durationMs",
          "source",
          "thumbnailUrl"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "artist": {
            "type": [
              "null",
              "string"
            ]
          },
          "durationMs": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "source": {
            "$ref": "#/components/schemas/MediaSource"
          },
          "thumbnailUrl": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SongSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "artist": {
            "type": "string"
          },
          "durationMs": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "source": {
            "type": "string"
          },
          "hasGuideVocals": {
            "type": "boolean"
          },
          "enqueueId": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "YouTubeEnqueueRequest": {
        "required": [
          "roomCode",
          "requestedByName",
          "videoId",
          "title",
          "channel",
          "durationSeconds"
        ],
        "type": "object",
        "properties": {
          "roomCode": {
            "type": "string"
          },
          "requestedByName": {
            "type": "string"
          },
          "videoId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "durationSeconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "thumbnailUrl": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "YouTubeSearchResultDto": {
        "required": [
          "videoId",
          "title",
          "channel",
          "durationSeconds",
          "thumbnailUrl"
        ],
        "type": "object",
        "properties": {
          "videoId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "durationSeconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "thumbnailUrl": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Karaokay.Api"
    }
  ]
}