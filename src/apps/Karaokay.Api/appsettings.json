{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MediaRoot": "media/library",
  "ConnectionStrings": {
    "Karaokay": ""
  },
  "Features": {
    "EnableYouTubeIngestion": false
  },
  "YtDlp": {
    "//": "MaxAttempts is TOTAL attempts: the initial try plus two retries (docs/ARCHITECTURE.md §4.2/§7).",
    "ExecutablePath": "yt-dlp",
    "JsRuntimes": [],
    "FfmpegLocation": "",
    "StagingRoot": ".staging",
    "CacheDirectory": "ytcache",
    "SearchTimeoutSeconds": 15,
    "DownloadTimeoutMinutes": 30,
    "MaxAttempts": 3,
    "DefaultMaxSearchResults": 10,
    "RetryBackoffSeconds": 2
  },
  "PublicBaseUrl": "",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  }
}
